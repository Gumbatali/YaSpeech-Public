.DS_Store
.local-data/
dist/
node_modules/
npm-debug.log*
*.m4a
*.mp3
*.wav
*.ogg
*.docx

# Секреты деплоя — никогда не коммитить
scripts/.env.deploy

# Локальные настройки Claude Code (сессионные данные, план-файлы)
.claude/

# Артефакты бенчмарка (пример-эталон оставляем в репо)
scripts/benchmark/data/manifest.jsonl
scripts/benchmark/data/*.flac
scripts/benchmark/report.json
scripts/benchmark/report.md

# Синтетический корпус диаризации и отчёты бенчмарка — генерируются локально
scripts/benchmark/data/synthetic/
scripts/benchmark/data/**/diarization-benchmark-report.json

# Веса моделей диаризации: гигабайты, качаются при первом старте контейнера
services/diarization/models/

# Реальные записи заказчика и их протоколы — приватные данные, не для репозитория
scripts/benchmark/results/real-meetings/

# Python-кэш
__pycache__/
*.pyc
