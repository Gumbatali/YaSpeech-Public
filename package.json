{
  "name": "yaspeech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node apps/server/src/dev-server.js",
    "test": "node --test packages/core/tests/*.test.js apps/server/tests/*.test.js apps/web/tests/*.test.js",
    "check": "node --test packages/core/tests/*.test.js apps/server/tests/*.test.js apps/web/tests/*.test.js"
  }
}
