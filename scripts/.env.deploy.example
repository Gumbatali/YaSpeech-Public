# YaSpeech — конфигурация деплоя
#
# Скопируй в scripts/.env.deploy и заполни. Файл .env.deploy в .gitignore — не коммитится.
#
# Первый деплой в новое облако:
#   1. Заполни поля ниже (до разделителя «── Заполняет bootstrap ──»)
#   2. bash scripts/deploy.sh bootstrap   # создаёт ресурсы, дописывает остальное
#   3. bash scripts/deploy.sh all         # деплоит код

# Folder ID каталога в Yandex Cloud (найти в консоли YC или: yc config get folder-id)
FOLDER_ID=

# Имена бакетов — будут созданы командой bootstrap (только латиница, цифры, дефис)
BUCKET=yaspeech-artifacts
FRONTEND_BUCKET=yaspeech-frontend

# Секрет для подписи сессионных cookie (сгенерировать: openssl rand -hex 32)
SESSION_SECRET=

# Логин первого администратора (любая строка)
ADMIN_LOGIN=admin

# Пароль администратора — используется только скриптом seed-admin.js, в функции не передаётся
ADMIN_PASSWORD=

# ── Заполняется автоматически командой bootstrap ──────────────────────────────
# Не трогай вручную — deploy.sh bootstrap запишет правильные значения.

# ID сервисного аккаунта
SA_ID=

# Статический ключ доступа (Object Storage + YMQ)
KEY_ID=
SECRET=

# URL очереди YMQ
QUEUE_URL=
