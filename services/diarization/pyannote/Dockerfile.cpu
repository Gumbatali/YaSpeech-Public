# pyannote Community-1 — CPU-вариант для замеров без GPU.
#
# Отличие от основного Dockerfile: база python:3.10-slim вместо CUDA-образа
# pytorch/pytorch. Образ меньше на порядок, а pyannote и так работает на CPU
# (медленнее GPU, но приемлемо: ~0.15x реального времени на 16 ядрах).
#
# Python 3.10, а не системный 3.8 из Ubuntu 20.04: pyannote.audio 3.3+
# не собирается под 3.8, а deadsnakes больше не публикует 3.10 под focal.
FROM python:3.10-slim

WORKDIR /app

ENV HF_HOME=/models \
    TORCH_HOME=/models \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=16

# build-essential нужен на этапе установки: часть зависимостей pyannote 4.x
# не имеет готовых колёс под 3.10-slim и собирается из исходников.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg build-essential \
    && rm -rf /var/lib/apt/lists/*

# torch CPU-сборкой: обычный пакет тянет ~2.5 ГБ CUDA-зависимостей,
# бесполезных без GPU.
RUN pip install --no-cache-dir \
      torch==2.4.1 torchaudio==2.4.1 --index-url https://download.pytorch.org/whl/cpu

# Версия 4.x обязательна для Community-1: её конфиг объявляет
# `dependencies: pyannote.audio: 4.0.0` и использует VBx-кластеризацию
# с PLDA, которой в 3.x просто нет — pipeline падает на
# "SpeakerDiarization.__init__() got an unexpected keyword argument 'plda'".
#
# soundfile/librosa намеренно БЕЗ пинов: pyannote 4.x требует более свежие
# версии, чем 0.12.1/0.10.2, и жёсткие пины дают ResolutionImpossible.
# Пусть их выбирает резолвер pip — pyannote тянет обе как свои зависимости.
#
# numpy тоже без пина. `numpy<2` заставлял pip собирать 1.x из исходников
# (готовых колёс под 3.10 для старых версий уже нет), а её .pyx не
# компилируется свежим Cython: "Cannot assign type ... except? -1LL nogil".
# pyannote 4.x с numpy 2.x работает штатно.
RUN pip install --no-cache-dir \
    "pyannote.audio>=4.0.0" \
    fastapi==0.115.0 \
    "uvicorn[standard]==0.30.6" \
    python-multipart==0.0.9

COPY common/ /app/common/
COPY pyannote/app.py /app/app.py

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
