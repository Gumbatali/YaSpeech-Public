# Шаблон для запуска кукбука. Скопируйте этот файл в .env и заполните
# реальными значениями. Никогда не коммитьте .env.

# Идентификатор каталога Yandex Cloud
# https://yandex.cloud/ru/docs/resource-manager/operations/folder/get-id
FOLDER_ID=

# API-ключ сервисного аккаунта для вызова YandexGPT и SpeechKit
# https://yandex.cloud/ru/docs/iam/operations/api-key/create
YC_API_KEY=

# Статические ключи доступа для Object Storage (S3-совместимое)
# https://yandex.cloud/ru/docs/iam/concepts/authorization/access-key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Имя бакета Object Storage для хранения аудио и артефактов пайплайна
BUCKET_NAME=yaspeech-cookbook-demo

# Модель YandexGPT — см. актуальный список: https://aistudio.yandex.ru/docs/ru/ai-studio/concepts/generation/models
GPT_MODEL=yandexgpt-5-lite