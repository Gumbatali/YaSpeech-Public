# YaSpeech deploy secrets
# Скопируй этот файл в scripts/.env.deploy и заполни реальными значениями.
# Файл .env.deploy добавлен в .gitignore и НЕ коммитится в git.

# Yandex Cloud Service Account ID
SA_ID=

# Object Storage bucket для артефактов (JSON, транскрипты, протоколы)
BUCKET=

# Object Storage bucket для фронтенда (SPA статика)
FRONTEND_BUCKET=

# YMQ Queue URL
QUEUE_URL=

# Статический ключ доступа SA (для S3 и YMQ)
KEY_ID=
SECRET=

# Folder ID проекта в YC
FOLDER_ID=

# Секрет для подписи сессионных токенов (случайная строка, мин. 32 символа)
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Логин первого администратора — при регистрации с этим логином получит роль admin автоматически
# Может быть любой строкой: "admin", "boss", "user@example.com" и т.п.
ADMIN_LOGIN=

# HuggingFace-токен с принятыми условиями моделей pyannote/speaker-diarization-3.1
# и pyannote/wespeaker-voxceleb-resnet34-LM — нужен сервису диаризации
# (apps/diarization-service). Получить: huggingface.co/settings/tokens
HF_TOKEN=

# YMQ-очередь для асинхронной диаризации (apps/diarization-service). URL —
# для отправки сообщений из Node; ARN — для триггера YMQ→контейнер.
# Создаётся один раз: см. apps/diarization-service, раздел деплоя.
DIARIZATION_QUEUE_URL=
DIARIZATION_QUEUE_ARN=
