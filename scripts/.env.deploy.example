# YaSpeech deploy secrets
# Скопируй этот файл в scripts/.env.deploy и заполни реальными значениями.
# Файл .env.deploy добавлен в .gitignore и НЕ коммитится в git.

# Yandex Cloud Service Account ID
SA_ID=

# Object Storage bucket для артефактов (JSON, транскрипты, протоколы)
BUCKET=

# Object Storage bucket для фронтенда (SPA статика)
FRONTEND_BUCKET=

# YMQ Queue URL
QUEUE_URL=

# Статический ключ доступа SA (для S3 и YMQ)
KEY_ID=
SECRET=

# Folder ID проекта в YC
FOLDER_ID=

# Секрет для подписи сессионных токенов (случайная строка, мин. 32 символа)
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Логин первого администратора — при регистрации с этим логином получит роль admin автоматически
# Может быть любой строкой: "admin", "boss", "user@example.com" и т.п.
ADMIN_LOGIN=

# ─────────────────────────────────────────────────────────────────────────────
# ASR и диаризация — всё ниже НЕОБЯЗАТЕЛЬНО.
# Если ничего не заполнять, работает как раньше: SpeechKit со встроенным
# разделением по спикерам.
# ─────────────────────────────────────────────────────────────────────────────

# speechkit (по умолчанию) | groq | smart
#   smart = Whisper для текста + отдельный диаризатор (см. DIARIZER ниже)
ASR_PROVIDER=

# Ключ Groq — нужен для ASR_PROVIDER=groq и smart
GROQ_API_KEY=

# Бэкенд диаризации (учитывается только при ASR_PROVIDER=smart):
#   none                 — без диаризации, спикеров расставит LLM-проход
#   pyannote-hf          — pyannote Community-1 через HuggingFace API (нужен HF_TOKEN)
#   pyannote-selfhosted  — свой сервис pyannote (нужен DIARIZER_URL)
#   nemo-sortformer      — NeMo Sortformer, offline, до 4 спикеров
#   streaming-sortformer — Streaming Sortformer v2.1, до 4 спикеров
#   diart                — diart, произвольное число участников
#   eend-eda             — EEND-EDA, pretrained CALLHOME
DIARIZER=

# Токен HuggingFace — только для DIARIZER=pyannote-hf
# Получить: huggingface.co/settings/tokens
# Также принять условия модели: huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Адрес GPU-сервиса диаризации — для всех бэкендов кроме pyannote-hf и none
# Например: http://51.250.x.x:8000
DIARIZER_URL=

# Bearer-токен для защиты GPU-сервиса (если включён)
DIARIZER_TOKEN=

# Таймаут воркера. Задаётся автоматически (60s обычно, 600s для smart),
# переопределяй только если понимаешь зачем.
WORKER_TIMEOUT=
